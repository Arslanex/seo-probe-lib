{
  "_doc": "Defaults of the monitoring operations. Every value is a keyword-only parameter of its operation.",
  "check_urls": {
    "concurrency": 8,
    "user_agent": "Googlebot",
    "max_page_bytes": 2097152
  },
  "check_redirects": {
    "concurrency": 8,
    "max_hops": 1,
    "temporary_statuses": [302, 307],
    "max_body_bytes": 65536
  },
  "diff": {
    "word_count_drop_pct": 30,
    "internal_links_change_pct": 30
  },
  "analyze_logs": {
    "chunk_lines": 5000,
    "max_line_chars": 8192,
    "top_paths": 20,
    "max_paths_per_bot": 5000,
    "max_tracked_ips": 20000,
    "max_ips_per_url": 32,
    "max_verify_ips": 200,
    "dns_concurrency": 16,
    "dns_timeout_s": 3.0,
    "spoofed_ips_listed": 10,
    "waste_share": 0.2,
    "server_error_share": 0.01,
    "unparsable_share": 0.05,
    "min_bot_requests": 50
  }
}
