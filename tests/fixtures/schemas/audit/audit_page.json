{
 "schema": {
  "$defs": {
   "AuditMode": {
    "enum": [
     "site",
     "page"
    ],
    "title": "AuditMode",
    "type": "string"
   },
   "AuditOptions": {
    "description": "The caller's options of an audit, normalised; ``rerun`` repeats them.",
    "properties": {
     "account": {
      "default": "default",
      "title": "Account",
      "type": "string"
     },
     "competitors": {
      "items": {
       "type": "string"
      },
      "title": "Competitors",
      "type": "array"
     },
     "extra_urls": {
      "items": {
       "type": "string"
      },
      "title": "Extra Urls",
      "type": "array"
     },
     "keywords": {
      "items": {
       "type": "string"
      },
      "title": "Keywords",
      "type": "array"
     },
     "link_check_budget_s": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Link Check Budget S"
     },
     "max_pages": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Max Pages"
     },
     "seed": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Seed"
     },
     "visibility_budget_s": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Visibility Budget S"
     }
    },
    "title": "AuditOptions",
    "type": "object"
   },
   "AuditStatus": {
    "enum": [
     "queued",
     "running",
     "partial",
     "completed",
     "failed",
     "canceled"
    ],
    "title": "AuditStatus",
    "type": "string"
   },
   "Category": {
    "enum": [
     "technical",
     "onpage",
     "links",
     "content",
     "schema",
     "performance",
     "ai_readiness",
     "images"
    ],
    "title": "Category",
    "type": "string"
   },
   "CategoryScore": {
    "properties": {
     "category": {
      "$ref": "#/$defs/Category"
     },
     "checks": {
      "items": {
       "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "array"
     },
     "checks_failed": {
      "default": 0,
      "title": "Checks Failed",
      "type": "integer"
     },
     "checks_passed": {
      "default": 0,
      "title": "Checks Passed",
      "type": "integer"
     },
     "checks_total": {
      "default": 0,
      "title": "Checks Total",
      "type": "integer"
     },
     "measured": {
      "title": "Measured",
      "type": "boolean"
     },
     "penalties": {
      "items": {
       "$ref": "#/$defs/Penalty"
      },
      "title": "Penalties",
      "type": "array"
     },
     "reason": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Reason"
     },
     "score": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Score"
     },
     "weight": {
      "title": "Weight",
      "type": "number"
     }
    },
    "required": [
     "category",
     "weight",
     "score",
     "measured"
    ],
    "title": "CategoryScore",
    "type": "object"
   },
   "CheckResult": {
    "description": "One applicable check behind a category score (\"show the checks behind every score\").",
    "properties": {
     "check_id": {
      "title": "Check Id",
      "type": "string"
     },
     "pages_affected": {
      "default": 0,
      "title": "Pages Affected",
      "type": "integer"
     },
     "pages_assessed": {
      "default": 1,
      "title": "Pages Assessed",
      "type": "integer"
     },
     "pass_ratio": {
      "title": "Pass Ratio",
      "type": "number"
     },
     "severity": {
      "$ref": "#/$defs/Severity"
     },
     "status": {
      "default": "pass",
      "enum": [
       "pass",
       "warn",
       "fail"
      ],
      "title": "Status",
      "type": "string"
     },
     "weight": {
      "title": "Weight",
      "type": "number"
     }
    },
    "required": [
     "check_id",
     "severity",
     "weight",
     "pass_ratio"
    ],
    "title": "CheckResult",
    "type": "object"
   },
   "ErrorCode": {
    "enum": [
     "invalid-url",
     "unsupported-scheme",
     "ssrf-blocked",
     "invalid-input",
     "dns-failed",
     "connect-failed",
     "tls-error",
     "fetch-timeout",
     "too-many-redirects",
     "rate-limited",
     "request-budget-exceeded",
     "missing-extra",
     "missing-credential",
     "browser-unavailable",
     "not-connected",
     "no-permission",
     "property-not-found",
     "api-quota-exceeded",
     "api-error",
     "timeout",
     "internal-error"
    ],
    "title": "ErrorCode",
    "type": "string"
   },
   "FieldData": {
    "description": "Real-user data (Chrome UX Report, 28-day p75). Public data; no site owner authorisation.",
    "properties": {
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Error"
     },
     "form_factor": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Form Factor"
     },
     "metrics": {
      "items": {
       "$ref": "#/$defs/FieldMetric"
      },
      "title": "Metrics",
      "type": "array"
     },
     "period": {
      "anyOf": [
       {
        "additionalProperties": {
         "type": "string"
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Period"
     },
     "scope": {
      "anyOf": [
       {
        "enum": [
         "url",
         "origin"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Scope"
     },
     "source": {
      "const": "crux",
      "default": "crux",
      "title": "Source",
      "type": "string"
     }
    },
    "title": "FieldData",
    "type": "object"
   },
   "FieldMetric": {
    "properties": {
     "good_share": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Good Share"
     },
     "metric": {
      "enum": [
       "lcp",
       "inp",
       "cls",
       "fcp",
       "ttfb"
      ],
      "title": "Metric",
      "type": "string"
     },
     "needs_improvement_share": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Needs Improvement Share"
     },
     "p75": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "P75"
     },
     "poor_share": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Poor Share"
     },
     "rating": {
      "anyOf": [
       {
        "enum": [
         "good",
         "needs-improvement",
         "poor"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Rating"
     }
    },
    "required": [
     "metric"
    ],
    "title": "FieldMetric",
    "type": "object"
   },
   "Finding": {
    "description": "One deterministic finding. Immutable once produced.",
    "properties": {
     "category": {
      "$ref": "#/$defs/Category"
     },
     "confidence": {
      "default": "high",
      "enum": [
       "high",
       "medium",
       "low"
      ],
      "title": "Confidence",
      "type": "string"
     },
     "count": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Count"
     },
     "effort": {
      "anyOf": [
       {
        "enum": [
         "S",
         "M",
         "L"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Effort"
     },
     "evidence": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Evidence"
     },
     "heuristic": {
      "default": false,
      "title": "Heuristic",
      "type": "boolean"
     },
     "id": {
      "title": "Id",
      "type": "string"
     },
     "impact": {
      "anyOf": [
       {
        "enum": [
         "low",
         "medium",
         "high"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Impact"
     },
     "layer": {
      "$ref": "#/$defs/Layer",
      "default": "A"
     },
     "message": {
      "title": "Message",
      "type": "string"
     },
     "message_key": {
      "title": "Message Key",
      "type": "string"
     },
     "recommendation": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Recommendation"
     },
     "recommendation_key": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Recommendation Key"
     },
     "rule_version": {
      "default": "0.1.0",
      "title": "Rule Version",
      "type": "string"
     },
     "scope": {
      "default": "page",
      "enum": [
       "page",
       "site"
      ],
      "title": "Scope",
      "type": "string"
     },
     "severity": {
      "$ref": "#/$defs/Severity"
     },
     "severity_original": {
      "anyOf": [
       {
        "$ref": "#/$defs/Severity"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "severity_reason": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Severity Reason"
     },
     "url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Url"
     }
    },
    "required": [
     "id",
     "category",
     "severity",
     "message_key",
     "message"
    ],
    "title": "Finding",
    "type": "object"
   },
   "Gate": {
    "properties": {
     "cap": {
      "title": "Cap",
      "type": "integer"
     },
     "check_id": {
      "title": "Check Id",
      "type": "string"
     },
     "reason": {
      "title": "Reason",
      "type": "string"
     }
    },
    "required": [
     "check_id",
     "cap",
     "reason"
    ],
    "title": "Gate",
    "type": "object"
   },
   "GscData": {
    "description": "Search Console data for the audited site (only with the owner's authorisation).",
    "properties": {
     "account": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Account"
     },
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Error"
     },
     "inspections": {
      "items": {
       "$ref": "#/$defs/GscInspection"
      },
      "title": "Inspections",
      "type": "array"
     },
     "period_days": {
      "default": 28,
      "title": "Period Days",
      "type": "integer"
     },
     "permission": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Permission"
     },
     "property": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Property"
     },
     "rankings": {
      "anyOf": [
       {
        "$ref": "#/$defs/KeywordRankings"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "sitemaps": {
      "items": {
       "$ref": "#/$defs/GscSitemap"
      },
      "title": "Sitemaps",
      "type": "array"
     },
     "status": {
      "default": "not-connected",
      "enum": [
       "ok",
       "not-connected",
       "not-configured",
       "property-not-found",
       "no-permission",
       "error"
      ],
      "title": "Status",
      "type": "string"
     },
     "top_pages": {
      "items": {
       "$ref": "#/$defs/GscRow"
      },
      "title": "Top Pages",
      "type": "array"
     },
     "top_queries": {
      "items": {
       "$ref": "#/$defs/GscRow"
      },
      "title": "Top Queries",
      "type": "array"
     },
     "totals": {
      "additionalProperties": {
       "type": "number"
      },
      "title": "Totals",
      "type": "object"
     }
    },
    "title": "GscData",
    "type": "object"
   },
   "GscInspection": {
    "description": "URL Inspection result of one page (Google's own view of it).",
    "properties": {
     "coverage_state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Coverage State"
     },
     "crawled_as": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Crawled As"
     },
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Error"
     },
     "google_canonical": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Google Canonical"
     },
     "indexed": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Indexed"
     },
     "indexing_state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Indexing State"
     },
     "last_crawl_time": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Last Crawl Time"
     },
     "page_fetch_state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Page Fetch State"
     },
     "robots_txt_state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Robots Txt State"
     },
     "url": {
      "title": "Url",
      "type": "string"
     },
     "user_canonical": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "User Canonical"
     },
     "verdict": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Verdict"
     }
    },
    "required": [
     "url"
    ],
    "title": "GscInspection",
    "type": "object"
   },
   "GscRow": {
    "properties": {
     "clicks": {
      "default": 0,
      "title": "Clicks",
      "type": "integer"
     },
     "ctr": {
      "default": 0.0,
      "title": "Ctr",
      "type": "number"
     },
     "impressions": {
      "default": 0,
      "title": "Impressions",
      "type": "integer"
     },
     "key": {
      "title": "Key",
      "type": "string"
     },
     "position": {
      "default": 0.0,
      "title": "Position",
      "type": "number"
     }
    },
    "required": [
     "key"
    ],
    "title": "GscRow",
    "type": "object"
   },
   "GscSitemap": {
    "properties": {
     "errors": {
      "default": 0,
      "title": "Errors",
      "type": "integer"
     },
     "is_pending": {
      "default": false,
      "title": "Is Pending",
      "type": "boolean"
     },
     "last_downloaded": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Last Downloaded"
     },
     "last_submitted": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Last Submitted"
     },
     "path": {
      "title": "Path",
      "type": "string"
     },
     "warnings": {
      "default": 0,
      "title": "Warnings",
      "type": "integer"
     }
    },
    "required": [
     "path"
    ],
    "title": "GscSitemap",
    "type": "object"
   },
   "ImageRecord": {
    "properties": {
     "above_fold": {
      "default": false,
      "title": "Above Fold",
      "type": "boolean"
     },
     "bytes": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Bytes"
     },
     "category": {
      "default": "content",
      "enum": [
       "thumbnail",
       "content",
       "hero"
      ],
      "title": "Category",
      "type": "string"
     },
     "displayed_h": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Displayed H"
     },
     "displayed_w": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Displayed W"
     },
     "has_alt": {
      "default": true,
      "title": "Has Alt",
      "type": "boolean"
     },
     "issues": {
      "items": {
       "type": "string"
      },
      "title": "Issues",
      "type": "array"
     },
     "lazy": {
      "default": false,
      "title": "Lazy",
      "type": "boolean"
     },
     "natural_h": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Natural H"
     },
     "natural_w": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Natural W"
     },
     "page_url": {
      "title": "Page Url",
      "type": "string"
     },
     "served_format": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Served Format"
     },
     "src": {
      "title": "Src",
      "type": "string"
     }
    },
    "required": [
     "page_url",
     "src"
    ],
    "title": "ImageRecord",
    "type": "object"
   },
   "IndexabilityRow": {
    "properties": {
     "canonical": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Canonical"
     },
     "depth": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Depth"
     },
     "in_sitemap": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "In Sitemap"
     },
     "indexable": {
      "default": true,
      "title": "Indexable",
      "type": "boolean"
     },
     "inlinks": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Inlinks"
     },
     "reasons": {
      "items": {
       "type": "string"
      },
      "title": "Reasons",
      "type": "array"
     },
     "status": {
      "anyOf": [
       {
